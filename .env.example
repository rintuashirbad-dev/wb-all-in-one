# Required: password for the admin panel (username defaults to "admin")
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_USERNAME=admin
# Recommended: long random string used to sign login tokens.
# If omitted, a random secret is generated once and stored in data/.jwt_secret
JWT_SECRET=
# Where the SQLite DB + uploads live (defaults to ./data and ./uploads)
PORTAL_DATA_DIR=./data
PORTAL_UPLOAD_DIR=./uploads
# Max upload size in MB
MAX_UPLOAD_MB=5
